---
import '../styles/global.css'
import  SpeedInsights  from "@vercel/speed-insights/astro"
import { ClientRouter } from "astro:transitions";
import Cursor from "../components/Cursor.astro";
---
<!doctype html>
<html lang="en" class="cursor-none">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>bruce moerdjiman</title>

		<link rel="preconnect" href="https://fonts.bunny.net">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lenis@1.2.3/dist/lenis.css">
		<ClientRouter />

		<!-- Hide animated elements from first paint — GSAP reveals them -->
		<style>
			.fade-in        { opacity: 0; }
			.fade-in-simple { opacity: 0 !important; }
			[data-split="heading"] { opacity: 0; }
		</style>
	</head>

	<body class=" bg-[#010101]  ">
		<div id="loader" style="position:fixed;inset:0;background:#000;z-index:9999;pointer-events:none;"></div>
		<main class=" font-ibm-sans">
			<slot />
		</main>

		<section class="expand
				fixed inset-0 w-screen h-screen py-4 pointer-events-none gap-4 grid
				grid-cols-3
				md:grid-cols-12
				-z-1 px-4
			 	[&>*]:h-full [&>*]:border-x [&>*]:border-white/20
			 	">
			<div class=""></div>
			<div class=""></div>
			<div class=""></div>
			<div class="max-md:hidden"></div>
			<div class="max-md:hidden"></div>
			<div class="max-md:hidden"></div>
			<div class="max-md:hidden"></div>
			<div class="max-md:hidden"></div>
			<div class="max-md:hidden"></div>
			<div class="max-md:hidden"></div>
			<div class="max-md:hidden"></div>
			<div class="max-md:hidden"></div>
		</section>
		<Cursor />
		<script>
			import { gsap } from 'gsap';

			const LOADER_DURATION = 0.6;

			window.addEventListener('load', () => {
				gsap.to('#loader', {
					opacity: 0,
					duration: LOADER_DURATION,
					ease: 'power2.inOut',
					onComplete: () => {
						const loader = document.getElementById('loader');
						if (loader) loader.style.display = 'none';
					}
				});

				gsap.from('.expand', {
					scaleY: 0,
					y: 50,
					duration: 1.2,
					delay: LOADER_DURATION * 0.5,
					ease: 'power2.out'
				});
			});

			// Lenis
			//const lenis = new Lenis({ autoRaf: true });
		</script>

	</body>
</html>
