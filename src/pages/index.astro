---
import Layout from "../layouts/Clean.astro";
---
<Layout>
    <section  class="top-0 left-0 flex flex-col justify-between w-full min-h-screen -z-1 overflow-hidden">
        <h1 class="fade-in text-white uppercase text-3xl md:text-8xl font-bold w-full pl-3.5 pt-4">
            Bruce Moerdjiman<span class="text-purple-600">*</span>
        </h1>



        <div data-us-project="DBZNZcT4rhhtNCjNOa0f" class="fade-in-simple opacity-70"  style=" z-index:-1 ; width:100vw; height: 100vh; position: fixed; top: 0; left: 0"></div>
        <script type="text/javascript">!function(){var u=window.UnicornStudio;if(u&&u.init){if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",function(){u.init()})}else{u.init()}}else{window.UnicornStudio={isInitialized:!1};var i=document.createElement("script");i.src="https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v2.0.5/dist/unicornStudio.umd.js",i.onload=function(){if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",function(){UnicornStudio.init()})}else{UnicornStudio.init()}},(document.head||document.body).appendChild(i)}}();</script>


        <p class="fade-in font-ibm-mono leading-5 text-xs md:text-3xl md:leading-12 tracking-wide text-white px-4 py-10 md:py-0">
            I’m a full‑stack developer and digital designer based in Rotterdam, blending creativity and technology for nearly two decades.
            <br/><br/>
            My experience spans from touring globally with artist Sevdaliza and performing as a VJ and lightjockey, to working with brands like Microsoft, Philips, and the International Film Festival Rotterdam.
            <br/><br/>
            Alongside teaching at the Rotterdam University of Applied Sciences, helping students prepare for their career as digital designer or developer.
            <br/><br/>
            I bring a multidisciplinary approach to creating digital products that are functional, refined, and crafted for a seamless user experience.
        </p>
        <style>
            .marquee-text {
                overflow: clip;
            }

            .marquee-text-track {
                width: max-content;
                animation: marquee-move-text 9s linear infinite forwards;
            }
            @keyframes marquee-move-text {
                to {
                    transform: translateX(-50%);
                }
            }
        </style>

        <nav class="fade-in  pl-4 md:absolute  md:top-8 md:right-8 flex md:justify-end gap-4 md:gap-6 pb-[2vw]">
            <a class="w-4 md:w-8 aspect-square hover:opacity-60 transition-all" href="https://github.com/broezer" title="Find me on Github!">
                <svg class="w-full h-full" width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9.5 0C4.25442 0 0 4.25363 0 9.5C0 13.6974 2.72175 17.2583 6.49721 18.5147C6.97142 18.6026 7.125 18.3081 7.125 18.0579V16.2893C4.48242 16.8641 3.93221 15.1683 3.93221 15.1683C3.49996 14.0703 2.87692 13.7782 2.87692 13.7782C2.01479 13.1884 2.94263 13.201 2.94263 13.201C3.89658 13.2675 4.3985 14.1803 4.3985 14.1803C5.24558 15.6323 6.62071 15.2127 7.163 14.9696C7.24771 14.3561 7.49392 13.9365 7.76625 13.6998C5.65646 13.4583 3.43821 12.6437 3.43821 9.00442C3.43821 7.96654 3.8095 7.11946 4.41671 6.45446C4.31854 6.21458 3.99317 5.24796 4.50933 3.94013C4.50933 3.94013 5.30733 3.68521 7.12262 4.91388C7.88025 4.70329 8.6925 4.598 9.5 4.59404C10.3075 4.598 11.1205 4.70329 11.8798 4.91388C13.6935 3.68521 14.4899 3.94013 14.4899 3.94013C15.0068 5.24875 14.6815 6.21537 14.5833 6.45446C15.1929 7.11946 15.561 7.96733 15.561 9.00442C15.561 12.6532 13.3388 13.4568 11.2235 13.6919C11.5639 13.9864 11.875 14.5643 11.875 15.451V18.0579C11.875 18.3105 12.027 18.6073 12.5091 18.5139C16.2814 17.256 19 13.6958 19 9.5C19 4.25363 14.7464 0 9.5 0Z" fill="white"/>
                </svg>

            </a>
            <a class="w-4 md:w-8 aspect-square hover:opacity-60 transition-all"  href="https://nl.linkedin.com/in/brucemoerdjiman" title="Connect with me on LinkedIn!">
                <svg class="w-full h-full" width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g clip-path="url(#clip0_10_76)">
                        <path d="M0 0V19H19V0H0ZM6.33333 15.0417H3.95833V6.33333H6.33333V15.0417ZM5.14583 5.3295C4.38108 5.3295 3.76042 4.70408 3.76042 3.933C3.76042 3.16192 4.38108 2.5365 5.14583 2.5365C5.91058 2.5365 6.53125 3.16192 6.53125 3.933C6.53125 4.70408 5.91138 5.3295 5.14583 5.3295ZM15.8333 15.0417H13.4583V10.6052C13.4583 7.93883 10.2917 8.14071 10.2917 10.6052V15.0417H7.91667V6.33333H10.2917V7.73063C11.3976 5.68338 15.8333 5.53217 15.8333 9.69079V15.0417Z" fill="white"/>
                    </g>
                    <defs>
                        <clipPath id="clip0_10_76">
                            <rect width="19" height="19" rx="4" fill="white"/>
                        </clipPath>
                    </defs>
                </svg>
            </a>

        </nav>

        <footer class="w-full fade-in">
            <div class="marquee-text">
                <div class="marquee-text-track flex px-2 pb-4 gap-4 text-white text-3xl  md:text-[5.5rem]">
                    <p class=""><span class="text-purple-600">*</span>your friendly neighborhood digital <span class="underline decoration-purple-600">artisan</span></p>
                    <p class="" aria-hidden="true"><span class="text-purple-600">*</span>your friendly neighborhood digital <span class="underline decoration-purple-600">artisan</span></p>
                </div>
            </div>
        </footer>
    </section>




    <script>
        import { gsap } from 'gsap';

        function pageLoadAnim() {
            gsap.from('.fade-in', {
                opacity: 0,
                y: 50,
                duration: 2,
                delay:0.75,
                stagger: 0.1,  // Cascade effect
                ease: 'back.out(1.7)'
            });

            gsap.from('.fade-in-simple', {
                opacity: 0,
                duration: 1,
                delay:0.2,
            });
        }
        document.addEventListener('astro:page-load', pageLoadAnim);
    </script>







</Layout>