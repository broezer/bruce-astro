---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---
<Layout>
    <section class=" top-0 left-0 flex flex-col justify-between w-full min-h-[95vh]">
        <h1 class="text-white uppercase text-8xl font-bold w-full pl-3.5 pt-4">
            Bruce<span class="text-purple-600">*</span>
        </h1>
        <style>
            .marquee-text {
                overflow: clip;
            }

            .marquee-text-track {
                display: flex;
                padding-left: 1rem;
                padding-bottom: 1rem;
                gap: 1rem;
                width: max-content;
                animation: marquee-move-text  8s linear infinite forwards;
            }




            @keyframes marquee-move-text {
                to {
                    transform: translateX(-50%);
                }
            }


        </style>
        <footer class="w-full">
            <div class="marquee-text">
                <div class="marquee-text-track text-white text-7xl">
                    <p class=""><span class="text-purple-600">*</span>your friendly neighborhood digital <span class="underline decoration-purple-600">artisan</span></p>
                    <p class="" aria-hidden="true"><span class="text-purple-600">*</span>your friendly neighborhood digital <span class="underline decoration-purple-600">artisan</span></p>
                </div>
            </div>

        </footer>
    </section>

    <section class="w-full min-h-screen relative bg-black z-100">
        <h2 class="text-white uppercase text-8xl font-bold w-full pl-3.5 pt-4">
            Other content
        </h2>
    </section>

</Layout>