---
import Test from "../layouts/Test.astro";
import Card from "../components/Card.astro";
---
<Test>
    <section class="h-screen w-[96vw] bg-white rounded-4xl mx-auto">

    </section>



    <section class="stack-container overflow-hidden">
        <div class="panel"> <h2>Boxing</h2></div>
        <div class="panel"> <h2>Karate</h2></div>
        <div class="panel"> <h2>Surfing</h2></div>
    </section>

    <script>
        import gsap from "gsap";
        import { ScrollTrigger } from 'gsap/ScrollTrigger';
        gsap.registerPlugin(ScrollTrigger);
        console.log(gsap.version);

        const stackContainer = document.querySelector(".stack-container");
        const panels = gsap.utils.toArray(".panel");

        ScrollTrigger.create({
            trigger: stackContainer,
            start: "top top",
            end: "+=" + (window.innerHeight * (panels.length - 1)),  // Scroll distance for (n-1) panels to stack
            pin: stackContainer,
            pinSpacing: false,
            scrub: 1,  // Smooth scrub matching your snap intent
            snap: 1 / (panels.length - 1),  // Snap to each panel position
            anticipatePin: 1,
            // Optional: Animate panels stacking (scale/opacity/y for polish)
            animation: gsap.timeline()
                .to(panels.slice(0, -1), {  // Animate all but last
                    scale: 0.9,
                    yPercent: -10,
                    stagger: 0.1,
                    ease: "none"
                }, 0),
            markers: true  // Remove in production
        });

        // Refresh after resize/DOM changes (key for dynamic content like WordPress)
        window.addEventListener("resize", () => ScrollTrigger.refresh());


    </script>

    <section class="h-screen w-[96vw] bg-white rounded-4xl mx-auto translate-y-[100vh]">

    </section>

</Test>
