<style>
    .cursor {
        z-index: 100;
        //background-color: #9c24ff;
        //border: 1px solid #9c24ff;
        //border-radius: 100em;
        width: 2em;
        height: 2em;
        //transition: background-color .375s cubic-bezier(.625, .05, 0, 1), height .375s cubic-bezier(.625, .05, 0, 1), width .375s cubic-bezier(.625, .05, 0, 1);
        position: fixed;
        inset: 0% auto auto 0%;
        pointer-events: none;

        .pointer{
            display: block;
        }
        .hover{
            display: none;
        }
    }

    body:has( a:hover) .cursor,
    body:has( button:hover) .cursor,
    body:has( [data-cursor]:hover) .cursor{
        //width: 3em;
        //height: 3em;
        //background-color: rgba(153, 36, 255, 0.3);
        .pointer{
            display: none;
        }
        .hover{
            display: block;
        }
    }

    @media (hover: none) and (pointer: coarse) {
        .cursor {
            display: none;
        }
    }
</style>
<script>
    import { gsap } from 'gsap';

    function initBasicCustomCursor() {

        gsap.set(".cursor", {xPercent:-50, yPercent: -50});

        let xTo = gsap.quickTo(".cursor", "x", {duration: 0.1, ease: "power3"});
        let yTo = gsap.quickTo(".cursor", "y", {duration: 0.1, ease: "power3"});

        window.addEventListener("mousemove", e => {
            xTo(e.clientX);
            yTo(e.clientY);
        });
    }

    // Initialize Basic Custom Cursor
    document.addEventListener('DOMContentLoaded', () => {
        initBasicCustomCursor();
    });
</script>