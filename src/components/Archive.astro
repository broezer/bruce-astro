<script>
import gsap from "gsap";
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);
console.log(gsap.version);

// gsap.utils.toArray(".panel").forEach((panel:any, i) => {
    //     ScrollTrigger.create({
        //         trigger: panel,
        //         start: "top top",
        //         pin: true,
        //         pinSpacing: false,
        //         snap: 1 / (gsap.utils.toArray(".panel").length - 1),  // Full-sequence snap
        //         //anticipatePin: 1,  // Preps for smooth entry
        //         onEnter: () => gsap.set(panel, { position: "fixed", top: 0, left: 0, width: "100%" }),  // Force stack position
        //         onLeave: () => gsap.set(panel, { clearProps: "all" }),
        //         markers: true  // Debug: remove later
        //     });
        // });

    const section = document.querySelector(".stack-container");
    const panels = gsap.utils.toArray(".stack-container .panel");

    const tl = gsap.timeline({
    scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom top",  // Full 400vh scroll distance
                pin: section,  // Pins entire section
                pinSpacing: true,
        scrub: 1,  // Precise scrub, snaps with your orig intent
                //anticipatePin: 1,
                markers: true  // Remove prod
            }
    });

    // Position each at viewport top (yPercent -100 * index) at exact progress
        tl.to(panels[0], { yPercent: -100 * 0, ease: "none" }, 0.0)  // Pin1 immediate (0vh)
            .to(panels[1], { yPercent: -100 * 1, ease: "none" }, 0.33)  // Pin2 at 200vh (200/400=0.5)
            .to(panels[2], { yPercent: -100 * 2, ease: "none" }, 0.66); // Pin3 at 300vh (300/400=0.75)

    ScrollTrigger.refresh();

    </script>

