<script>
    import gsap from "gsap";
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);
    console.log(gsap.version);

    gsap.to("#crafting", {
        scale: 1,
        duration: 1,
        y: -window.innerHeight/8,
        scrollTrigger: {
            trigger: "#crafting",
            start: "top 80%",
            end: "top 40%",
            scrub: true,  // Links animation progress to scroll
            //markers: true  // Uncomment for debugging
        }
    });

    gsap.to("#crafting .content-title", {
        scale: 1,
        duration: 1,
        scrollTrigger: {
            trigger: ".content-title",
            start: "top 80%",
            end: "top 40%",
            scrub: true,  // Links animation progress to scroll
            //markers: true  // Uncomment for debugging
        }
    });

    gsap.to("#crafting img", {
        scale: 1,
        y:0,
        duration: 1,
        scrollTrigger: {
            trigger: ".content-title",
            start: "top 80%",
            end: "top 40%",
            scrub: true,  // Links animation progress to scroll
            //markers: true  // Uncomment for debugging
        }
    });

</script>

